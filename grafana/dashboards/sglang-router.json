      },
      "id": 1,
      "options": {
        "content": "# SGLang Router Metrics\n\nThis dashboard covers **61 metric families** for the standalone SGLang Router and Router Mesh. It uses the shared Prometheus data source `Prometheus` and selects scrape targets by their SGLang role label. Placeholder targets can be DOWN until the corresponding process is started. Metrics are lazily registered, so feature-gated metrics may show no data.",
        "mode": "markdown"
      },
      "title": "Dashboard Scope",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 2,
      "panels": [],
      "title": "HTTP and Router Requests",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Complete metric-family coverage for this module. Counter panels show rate, histogram panels show p95, and gauges show the current value. Feature-gated or event-created metrics can legitimately return no data.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (instance) (rate(smg_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} smg_http_requests_total",
          "refId": "Q01"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (instance) (rate(smg_http_responses_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} smg_http_responses_total",
          "refId": "Q02"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (instance) (rate(smg_http_rate_limit_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} smg_http_rate_limit_total",
          "refId": "Q03"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (instance) (rate(smg_router_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} smg_router_requests_total",
          "refId": "Q04"
